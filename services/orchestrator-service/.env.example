# ═══════════════════════════════════════════════════════════════════════════════
# Orchestrator Service — Environment Variables
# Copy to .env and fill in for local development
# In GKE, these come from ConfigMaps / Secret Manager
# ═══════════════════════════════════════════════════════════════════════════════

# Service
SERVICE_NAME=orchestrator-service
SERVICE_PORT=9501
LOG_LEVEL=INFO
ENVIRONMENT=development

# LLM Gateway (LiteLLM for dev, deployed Cloud Run for demo/prod)
# Local:    http://localhost:4000/v1
# Deployed: https://aigateway.cilabs.np.cc-hki.com/v1
LLM_GATEWAY_URL=http://localhost:4000/v1
LLM_API_KEY=sk-1234
LLM_MODEL_DEFAULT=gemini-2.0-flash
LLM_MODEL_FAST=gemini-2.0-flash
LLM_MODEL_SMART=gemini-2.5-pro
LLM_MODEL_THINKING=gemini-2.5-flash
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3
LLM_REQUEST_TIMEOUT=60.0

# ADK Agent
AGENT_MODEL=gemini-2.5-flash
AGENT_MODEL_FAST=gemini-2.5-flash
AGENT_MODEL_SMART=gemini-2.5-pro
AGENT_MODEL_THINKING=gemini-2.5-flash
MAX_CONCURRENT_CHATS=100
GCP_LOCATION=us-central1

# Redis
REDIS_URL=redis://localhost:9379/0
REDIS_KEY_PREFIX=orch:

# Guardrails
GUARDRAILS_MAX_INPUT_LENGTH=5000
GUARDRAILS_RATE_LIMIT_RPM=100
GUARDRAILS_BLOCK_ON_OUTPUT_FAIL=false

# Downstream services
KNOWLEDGE_API_URL=http://localhost:9509
VECTOR_STORE_URL=http://localhost:9509
KNOWLEDGE_PIPELINE_URL=http://localhost:9508
# Local dev wrappers start analytics on :9510. In-cluster config stays on :9512.
ANALYTICS_SERVICE_URL=http://localhost:9510

# Corrective RAG
CORRECTIVE_RAG_ENABLED=true
CORRECTIVE_RAG_MIN_RELEVANCE=0.4
CORRECTIVE_RAG_MAX_RETRIES=1

# Corrective RAG
CORRECTIVE_RAG_ENABLED=true
CORRECTIVE_RAG_MIN_RELEVANCE=0.4
CORRECTIVE_RAG_MAX_RETRIES=1

# Service Auth (request JWT from BFF)
# In local dev, set AUTH_ENABLED=false to skip JWT verification.
# In prod, SERVICE_AUTH_SECRET must match the BFF's signing key.
SERVICE_AUTH_SECRET=
AUTH_ENABLED=false

# Observability — OpenTelemetry distributed tracing
# Set OTEL_ENABLED=true + GCP_PROJECT_ID to export traces to Cloud Trace.
# In local dev, traces go to console when enabled.
OTEL_ENABLED=false
OTEL_EXPORTER_ENDPOINT=
GCP_PROJECT_ID=
GCP_REGION=us-central1
CORS_ORIGINS=http://localhost:9001,http://localhost:9002,http://localhost:3000
