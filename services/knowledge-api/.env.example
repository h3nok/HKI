# ═══════════════════════════════════════════════════════════════════════════════
# Knowledge API — Environment Variables
# Copy to .env and fill in for local development
# In GKE, non-sensitive values come from ConfigMap; secrets from Secret Manager
# ═══════════════════════════════════════════════════════════════════════════════

# Service
SERVICE_NAME=knowledge-api
SERVICE_PORT=9509
LOG_LEVEL=INFO
ENVIRONMENT=development
KB_HERMETIC_ISOLATION=true

# Embedding (LiteLLM gateway for dev; Vertex AI direct for prod when URL is empty)
EMBEDDING_GATEWAY_URL=http://localhost:4000/v1
EMBEDDING_API_KEY=sk-1234
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768
VERTEX_AI_LOCATION=us-central1

# Search defaults
MAX_RESULTS=10
SIMILARITY_THRESHOLD=0.3
BM25_WEIGHT=0.3
VECTOR_WEIGHT=0.7

# AlloyDB (production vector store)
# Local:  postgresql://postgres:postgres@localhost:9432/knowledge
# GKE:    postgresql://postgres@localhost:5432/knowledge  (via AlloyDB Auth Proxy sidecar)
ALLOYDB_URL=postgresql://postgres:postgres@localhost:9432/knowledge
ALLOYDB_POOL_MIN=2
ALLOYDB_POOL_MAX=20

# Neo4j (knowledge graph — optional)
# Local:  bolt://localhost:9687
# Aura:   neo4j+s://xxxx.databases.neo4j.io
NEO4J_URI=bolt://localhost:9687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=knowledge
NEO4J_DATABASE=neo4j

# Entity extraction
ENTITY_EXTRACTION_ENABLED=true
ENTITY_EXTRACTION_MODEL=gemini-2.0-flash

# Pipeline write secret (must match KNOWLEDGE_API_PIPELINE_SECRET in pipeline service)
# In production, sourced from Secret Manager
PIPELINE_SERVICE_SECRET=

# Analytics Service
# Local dev wrappers start analytics on :9510. In-cluster config stays on :9512.
ANALYTICS_SERVICE_URL=http://localhost:9510

# Redis (optional caching)
REDIS_URL=redis://localhost:9379/1

# Auth
SERVICE_AUTH_SECRET=dev-service-auth-secret-change-in-prod
AUTH_ENABLED=false

# GCP
GCP_PROJECT_ID=
GCP_REGION=us-central1

# Observability
OTEL_ENABLED=false
OTEL_EXPORTER_ENDPOINT=

# CORS
CORS_ORIGINS=http://localhost:9001,http://localhost:9002,http://localhost:9501
