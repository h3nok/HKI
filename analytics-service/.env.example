# ═══════════════════════════════════════════════════════════════════════════════
# Analytics Service — Environment Variables
# Copy to .env and fill in for local development
# In GKE, these come from ConfigMaps / Secret Manager
# ═══════════════════════════════════════════════════════════════════════════════

# Service
SERVICE_NAME=analytics-service
# Local dev scripts bind analytics on :9510. Container and cluster runtime use :9512.
SERVICE_PORT=9512
LOG_LEVEL=INFO
ENVIRONMENT=development

# Database (BigQuery or Cloud SQL — leave blank for in-memory dev mode)
DATABASE_URL=
BQ_DATASET=analytics
BQ_TABLE_EVENTS=agent_events

# Event Buffer
EVENT_BUFFER_MAX=10000

# Downstream Services
ORCHESTRATOR_URL=http://localhost:9501

# GCP
GCP_PROJECT_ID=
GCP_REGION=us-central1

# Auth
SERVICE_AUTH_SECRET=
AUTH_ENABLED=false

# Observability
OTEL_ENABLED=false
LLM_API_KEY=

# CORS
CORS_ORIGINS=http://localhost:9001,http://localhost:9002,http://localhost:3000
