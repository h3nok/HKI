{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hki.dev/schema/hki-audit-event.schema.json",
  "title": "HKI Audit Event",
  "description": "Evidence-grade audit event for HKI runtime, admin, publication, and imported agent-platform activity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "event_id",
    "occurred_at",
    "received_at",
    "source",
    "actor",
    "boundary",
    "operation",
    "decision"
  ],
  "properties": {
    "schema": { "const": "hki.audit.event.v1" },
    "event_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "received_at": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "service"],
      "properties": {
        "platform": { "type": "string", "minLength": 1, "maxLength": 128 },
        "service": { "type": "string", "minLength": 1, "maxLength": 128 },
        "environment": { "type": "string", "minLength": 1, "maxLength": 128 },
        "collector": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id"],
      "properties": {
        "subject_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "email_hash": { "type": "string", "minLength": 1, "maxLength": 256 },
        "role": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["org_id", "active_domain", "authorized_domains"],
      "properties": {
        "org_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "active_domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "not": { "enum": ["global", "*"] }
        },
        "authorized_domains": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "not": { "enum": ["global", "*"] }
          }
        },
        "policy_pack_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "risk_tier": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "target_domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "not": { "enum": ["global", "*"] }
        },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 128 },
        "plane": { "enum": ["runtime", "admin", "publication", "imported"] }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome"],
      "properties": {
        "outcome": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 512 },
        "requires_human_approval": { "type": "boolean" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trace_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "request_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "payload_hash": { "type": "string", "minLength": 1, "maxLength": 256 },
        "payload_ref": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "redaction_profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  }
}
