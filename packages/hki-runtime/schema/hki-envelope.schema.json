{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hki:schema:envelope:1.0",
  "title": "HKI Runtime Envelope",
  "description": "Signed runtime scope envelope for Hermetic Knowledge Isolation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hki_version",
    "envelope_id",
    "org_id",
    "subject_id",
    "active_domain",
    "authorized_domains",
    "purpose",
    "risk_tier",
    "policy_pack_id",
    "issued_at",
    "expires_at",
    "issuer",
    "signature"
  ],
  "properties": {
    "hki_version": {
      "const": "1.0"
    },
    "envelope_id": {
      "type": "string",
      "minLength": 1
    },
    "org_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "active_domain": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![Gg][Ll][Oo][Bb][Aa][Ll]$)(?!\\*$).+"
    },
    "authorized_domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?![Gg][Ll][Oo][Bb][Aa][Ll]$)(?!\\*$).+"
      },
      "uniqueItems": true
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "risk_tier": {
      "type": "string",
      "minLength": 1
    },
    "policy_pack_id": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": "number"
    },
    "expires_at": {
      "type": "number"
    },
    "issuer": {
      "type": "string",
      "minLength": 1
    },
    "signature": {
      "type": "string",
      "minLength": 1
    }
  }
}
