{
  "name": "@hki/runtime",
  "version": "0.1.0",
  "description": "Hermetic Knowledge Isolation runtime envelope, cache, gateway, and telemetry helpers.",
  "license": "MIT",
  "author": "Henok Ghebrechristos",
  "homepage": "https://github.com/h3nok/HKI",
  "repository": {
    "type": "git",
    "url": "https://github.com/h3nok/HKI.git",
    "directory": "packages/hki-runtime"
  },
  "bugs": {
    "url": "https://github.com/h3nok/HKI/issues"
  },
  "sideEffects": false,
  "keywords": [
    "agent-security",
    "agentic-ai",
    "ai-governance",
    "conformance",
    "hki",
    "isolation",
    "mcp",
    "rag",
    "zero-trust"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "schema",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./schema/hki-envelope.schema.json": "./schema/hki-envelope.schema.json",
    "./schema/hki-artifact-label.schema.json": "./schema/hki-artifact-label.schema.json",
    "./schema/hki-audit-event.schema.json": "./schema/hki-audit-event.schema.json"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@hki/typescript-config": "workspace:*",
    "@types/node": "^25.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "7.3.2",
    "vitest": "4.1.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
