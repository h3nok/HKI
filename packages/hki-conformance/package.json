{
  "name": "@hki/conformance",
  "version": "0.1.0",
  "description": "Hermetic Knowledge Isolation conformance fixtures, adapter contract, and certification runner.",
  "license": "MIT",
  "author": "Henok Ghebrechristos",
  "homepage": "https://github.com/h3nok/HKI",
  "repository": {
    "type": "git",
    "url": "https://github.com/h3nok/HKI.git",
    "directory": "packages/hki-conformance"
  },
  "bugs": {
    "url": "https://github.com/h3nok/HKI/issues"
  },
  "sideEffects": false,
  "keywords": [
    "agent-security",
    "agentic-ai",
    "ai-governance",
    "certification",
    "conformance",
    "hki",
    "isolation",
    "mcp",
    "zero-trust"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "templates",
    "schemas",
    "README.md"
  ],
  "bin": {
    "hki-conformance": "./dist/cli.js",
    "hki-probe": "./dist/probe.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "conformance": "node dist/cli.js",
    "prebuild": "node ../../scripts/ensure-package-built.mjs ../hki-runtime",
    "prepack": "pnpm build",
    "pretest": "node ../../scripts/ensure-package-built.mjs ../hki-runtime",
    "pretypecheck": "node ../../scripts/ensure-package-built.mjs ../hki-runtime",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "probe:smoke": "node scripts/mock-gateway.mjs 9780 & sleep 0.5 && node dist/probe.js http://127.0.0.1:9780 --route /v1/chat --out /tmp/hki-evidence.json; status=$?; kill %1 2>/dev/null; exit $status"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@hki/runtime": "workspace:*"
  },
  "devDependencies": {
    "@hki/typescript-config": "workspace:*",
    "@types/node": "^24.12.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "7.3.2",
    "vitest": "4.1.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
