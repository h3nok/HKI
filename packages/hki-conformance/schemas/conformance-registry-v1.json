{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hki.dev/schemas/conformance-registry/v1.json",
  "title": "HKI Conformance Registry",
  "description": "Evidence artifact emitted by an HKI-conformant repository, enumerating the conformance cases passed, audit-debt baseline, and threat-catalog coverage. Consumers of the public registry validate this document against this schema.",
  "type": "object",
  "required": [
    "$schema",
    "generatedAt",
    "implementation",
    "packages",
    "conformance",
    "audit",
    "threats",
    "evidenceProfile",
    "releaseEvidence",
    "level"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "implementation": {
      "type": "object",
      "required": ["name", "repository", "commit", "branch"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "repository": { "type": "string" },
        "commit": { "type": "string", "minLength": 1 },
        "branch": { "type": "string" },
        "dirty": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "packages": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [{ "type": "string" }, { "type": "null" }]
      }
    },
    "conformance": {
      "type": "object",
      "required": ["passed", "total", "overallPassed"],
      "properties": {
        "passed": { "type": ["integer", "null"], "minimum": 0 },
        "total": { "type": ["integer", "null"], "minimum": 0 },
        "overallPassed": { "type": ["boolean", "null"] },
        "cases": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "required": ["id", "passed"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "title": { "type": ["string", "null"] },
              "severity": {
                "type": ["string", "null"],
                "enum": ["must", "should", "may", null]
              },
              "passed": { "type": "boolean" }
            },
            "additionalProperties": true
          }
        },
        "error": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "audit": {
      "type": "object",
      "properties": {
        "baseline": { "type": ["integer", "null"], "minimum": 0 },
        "byRule": {
          "type": ["object", "null"],
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "baselineGeneratedAt": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "threats": {
      "type": "object",
      "required": ["total", "ids"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^HKI-T\\d+$"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "httpProbe": {
      "type": ["object", "null"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "level_claim": { "type": "integer", "minimum": 0 },
        "evidence_profile": {
          "type": "string",
          "enum": ["none", "smoke", "live", "release"]
        },
        "bundle_hash": { "type": "string" },
        "target": { "type": "object", "additionalProperties": true },
        "generated_at": { "type": "string" }
      },
      "additionalProperties": true
    },
    "evidenceProfile": {
      "type": "string",
      "enum": ["none", "smoke", "live", "release"]
    },
    "releaseEvidence": {
      "type": "object",
      "required": [
        "schemaVersion",
        "level",
        "evidenceProfile",
        "generatedBy",
        "commandManifest",
        "componentHashes",
        "verification",
        "releaseReadiness",
        "manifestHash"
      ],
      "properties": {
        "schemaVersion": { "type": "string", "minLength": 1 },
        "level": { "type": "string" },
        "evidenceProfile": {
          "type": "string",
          "enum": ["none", "smoke", "live", "release"]
        },
        "generatedBy": { "type": "string", "minLength": 1 },
        "commandManifest": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "command", "status"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "command": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": true
          }
        },
        "componentHashes": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [{ "type": "string" }, { "type": "null" }]
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": true
        },
        "releaseReadiness": {
          "type": "object",
          "required": [
            "strictReleaseEligible",
            "status",
            "blockers",
            "warnings"
          ],
          "properties": {
            "strictReleaseEligible": { "type": "boolean" },
            "status": { "type": "string", "enum": ["ready", "blocked"] },
            "blockers": { "type": "array" },
            "warnings": { "type": "array" }
          },
          "additionalProperties": true
        },
        "manifestHash": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "level": {
      "type": "string",
      "enum": [
        "L0-documented",
        "L1-labeled",
        "L2-routed",
        "L3-enforced",
        "L4-tested",
        "L5-audited"
      ]
    }
  },
  "additionalProperties": true
}
