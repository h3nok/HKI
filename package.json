{
  "name": "hki",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:agentic": "turbo run dev --filter=@hki/agentic",
    "dev:ipms": "turbo run dev --filter=@hki/ipms",
    "build": "turbo run build",
    "build:agentic": "turbo run build --filter=@hki/agentic",
    "build:ipms": "turbo run build --filter=@hki/ipms",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "test": "turbo run test",
    "test:all": "turbo run test && make test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "prettier": "^3.8.1",
    "turbo": "^2.8.19"
  },
  "pnpm": {
    "allowedDeprecatedVersions": {
      "@esbuild-kit/core-utils": "3.3.2",
      "@esbuild-kit/esm-loader": "2.6.5",
      "node-domexception": "1.0.0"
    },
    "overrides": {
      "@unhead/vue": "^2.1.13",
      "@types/react": "^19.0.0",
      "@types/react-dom": "^19.0.0",
      "axios": "^1.15.0",
      "defu": "^6.1.5",
      "drizzle-orm": "^0.45.2",
      "tailwindcss>nanoid": "3.3.7",
      "fdir>picomatch": "^4.0.4",
      "follow-redirects": "^1.16.0",
      "minimatch": "^10.2.3",
      "minimatch>brace-expansion": "^5.0.5",
      "micromatch>picomatch": "^2.3.2",
      "rollup": "^4.59.0",
      "flatted": "^3.4.0",
      "undici": "^7.24.4",
      "fast-xml-parser": "^5.5.7",
      "ajv": "^6.14.0",
      "esbuild": "^0.25.0",
      "tar": "^7.5.11",
      "lodash": "^4.17.23",
      "lodash-es": "^4.18.0",
      "next": "^16.2.3",
      "path-to-regexp": "^8.4.0",
      "picomatch": "^4.0.4",
      "qs": "^6.14.2",
      "dompurify": "^3.4.0",
      "unhead": "^2.1.13",
      "vite": "^7.3.2",
      "yaml": "^2.8.3"
    }
  },
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
