# ═══════════════════════════════════════════════════════════════════════════════
# Knowledge Pipeline Service — Environment Variables
# Copy to .env and fill in for local development
# In GKE, these come from ConfigMaps / Secret Manager
# ═══════════════════════════════════════════════════════════════════════════════

# Service
SERVICE_NAME=ingestion-pipeline-service
SERVICE_PORT=9508
LOG_LEVEL=INFO
ENVIRONMENT=development
KB_HERMETIC_ISOLATION=true

# Downstream Services
KNOWLEDGE_API_URL=http://localhost:9509

# Redis (job persistence — leave blank for in-memory fallback)
REDIS_URL=
REDIS_JOB_TTL_HOURS=72
REDIS_JOB_PREFIX=kp:job:

# Processing Limits
MAX_DOCUMENT_SIZE_MB=50
MAX_CONCURRENT_JOBS=5
DEFAULT_CHUNK_SIZE=512
DEFAULT_CHUNK_OVERLAP=64
DEFAULT_CHUNK_STRATEGY=sentence

# Retry / Resilience
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=1.0
RETRY_MAX_DELAY=30.0

# Gemini Contextualization (leave disabled for basic dev)
GEMINI_ENABLED=false
GEMINI_MODEL=gemini-2.0-flash
GEMINI_PROJECT_ID=
GEMINI_LOCATION=us-central1
GEMINI_MAX_CONCURRENT=5
GEMINI_CONTEXT_MAX_TOKENS=200

# Cloud Storage landing zone (leave disabled for local dev)
GCS_ENABLED=false
GCS_BUCKET=
GCS_PREFIX=knowledge/raw/

# Document AI OCR/layout extraction (optional)
DOCAI_ENABLED=false
DOCAI_PROCESSOR_ID=

# Cloud Pub/Sub job queue (leave disabled for inline asyncio dev mode)
PUBSUB_ENABLED=false
PUBSUB_PROJECT_ID=
PUBSUB_TOPIC=knowledge-ingestion
PUBSUB_SUBSCRIPTION=knowledge-ingestion-worker
PUBSUB_DLQ_TOPIC=knowledge-ingestion-dlq
PUBSUB_ACK_DEADLINE_SEC=600
PUBSUB_MAX_DELIVERY_ATTEMPTS=5
PUBSUB_EMULATOR_HOST=

# Per-tenant Concurrency
CONCURRENCY_MAX_PER_ORG=5
CONCURRENCY_KEY_PREFIX=kp:concurrency:
CONCURRENCY_SLOT_TTL=3600

# Web Scraping
SCRAPER_TIMEOUT=30.0
SCRAPER_MAX_PAGES=10

# Observability Data Source
OBSERVABILITY_BACKEND=cache
OBSERVABILITY_LOOKBACK_MINUTES=60
DYNATRACE_BASE_URL=
DYNATRACE_API_TOKEN=
DYNATRACE_LOGS_ENDPOINT=/api/v2/logs/export
DYNATRACE_TIMEOUT_SEC=8.0
DYNATRACE_LOG_QUERY=log_type="llm_trace"

# Auth
SERVICE_AUTH_SECRET=
AUTH_ENABLED=false

# Observability
OTEL_ENABLED=false
GCP_PROJECT_ID=
GCP_REGION=us-central1
LLM_API_KEY=

# CORS
CORS_ORIGINS=http://localhost:9001,http://localhost:9002,http://localhost:9501
