# ═══════════════════════════════════════════════════════════════════════════════
# Agentic Frontend — Environment Variables
# Copy to .env and fill in for local development
# In GKE, these come from ConfigMaps / Secret Manager
# ═══════════════════════════════════════════════════════════════════════════════

# Node
NODE_ENV=development
PORT=9001
KB_HERMETIC_ISOLATION=true

# Database (MySQL — same instance as docker-compose)
DATABASE_URL=mysql://root:password@localhost:9306/retail_agentic?charset=utf8mb4

# Auth / Sessions
JWT_SECRET=local-dev-jwt-secret-67890
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# App
VITE_APP_ID=agentic

# Orchestrator
ORCHESTRATOR_URL=http://localhost:9501
# Production fallback for KB/admin Gemini routes: when the LLM gateway returns
# 429/5xx or times out, Agentic can retry through the orchestrator's direct
# Vertex AI path. Set to false to disable.
ENABLE_GEMINI_ORCHESTRATOR_FALLBACK=true

# Knowledge Platform
KNOWLEDGE_PIPELINE_URL=http://localhost:9508
KNOWLEDGE_API_URL=http://localhost:9509

# Analytics Service — backend API for usage analytics
ANALYTICS_URL=http://localhost:9510

# Service-to-service auth (shared HS256 secret for BFF ↔ Python services)
SERVICE_AUTH_SECRET=local-dev-secret-key-12345

# GCP-native observability dashboard link used by the UI
VITE_OBSERVABILITY_URL=https://console.cloud.google.com/monitoring/dashboards?project=p-642-cilab-gke

# LLM Gateway (LiteLLM)
# Local default: docker-compose LiteLLM proxy on :4000
# If using deployed gateway, ensure required network/IAP identity auth is satisfied.
LLM_GATEWAY_URL=http://localhost:4000/v1
LLM_API_KEY=sk-1234

# Google OAuth (optional for dev — required for production SSO)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CONNECTOR_CREDENTIALS_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:9001/api/connectors/google-drive/callback

# Analytics (Umami) — client-side tracking (currently disabled in dev)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Redis — required for multi-pod WebSocket trace broadcast in GKE.
# Without this, real-time thought trace + job status updates are local to a single pod.
# In dev, leave empty — single-process broadcast "just works".
REDIS_URL=

# Base URL — used for OAuth callback construction and email link generation.
# In production, set to the primary external URL (e.g. https://agentic.hki.com)
BASE_URL=http://localhost:9001

# Access request reviewer fallback — comma-separated emails.
# Receives notifications when no admin/manager users exist yet in the DB.
KNOWLEDGE_ACCESS_REQUEST_RECIPIENTS=
