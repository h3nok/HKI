  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/express": "5.0.6",
    "@types/google.maps": "^3.64.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-resizable": "^3.0.8",
    "@types/ws": "^8.18.1",
    "add": "^2.0.6",
