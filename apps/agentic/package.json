{
  "name": "@hki/agentic",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/clean-vite-cache.mjs --if-stale && NODE_ENV=development PORT=9001 tsx watch --ignore './client/**' server/_core/index.ts",
    "dev:vite-clean": "node scripts/clean-vite-cache.mjs",
    "build": "vite build && esbuild server/_core/index.ts server/_core/db-migrate-cli.ts --entry-names=[name] --platform=node --packages=external --external:./server/_core/vite --bundle --format=esm --outdir=dist && pnpm bundle:check",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test:kb-role-e2e": "tsx scripts/kb-role-flows-e2e.ts",
    "test:kb-feature-flags-e2e": "tsx scripts/kb-feature-flags-e2e.ts",
    "test:kb-ui-e2e": "tsx scripts/kb-ui-e2e.ts",
    "test:kb-api-e2e": "tsx scripts/kb-api-e2e.ts",
    "test:kb-gke-hvsi-smoke": "tsx scripts/kb-gke-hvsi-smoke.ts",
    "ui:smoke": "node scripts/agentic-ui-smoke.mjs",
    "bundle:check": "node scripts/check-client-bundle.mjs",
    "kb:user:cleanup": "tsx scripts/kb-user-cleanup.ts",
    "test:kb-e2e-all": "pnpm test:kb-role-e2e && pnpm test:kb-ui-e2e && pnpm test:kb-api-e2e",
    "test:client": "vitest run client/src/components",
    "test": "vitest run",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx ./scripts/db-migrate.ts",
    "db:migrate:status": "tsx ./scripts/db-migrate-status.ts",
    "db:migrate:preflight": "tsx ./scripts/db-migrate-preflight.ts",
    "db:hvsi:inventory": "tsx ./scripts/hvsi-inventory.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
