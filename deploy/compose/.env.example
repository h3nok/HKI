# AI Platform - Docker Compose Configuration
# Copy this file to .env and modify as needed
# These defaults match the documented local development stack.

# MySQL
MYSQL_PORT=9306

# PostgreSQL + pgvector (AlloyDB-compatible, used by Knowledge API)
POSTGRES_PORT=9432
POSTGRES_DB=knowledge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis (orchestrator cache + ingestion pipeline job store)
REDIS_PORT=9379

# LiteLLM
# Keep this on 4000 unless you also update the local service URLs that talk to LiteLLM.
LITELLM_PORT=4000
VERTEX_PROJECT=p-642-cilab-sandbox
VERTEX_LOCATION=us-central1
