# AI Platform - Docker Compose Configuration
# Copy this file to .env and modify as needed
# These defaults match the documented local development stack.

# MySQL
MYSQL_PORT=9306

# PostgreSQL
POSTGRES_PORT=9432
POSTGRES_DB=retail_agentic
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis
REDIS_PORT=9379

# MongoDB
MONGODB_PORT=9017
MONGO_USER=admin
MONGO_PASSWORD=admin

# RabbitMQ
RABBITMQ_PORT=9672
RABBITMQ_MGMT_PORT=9673
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin

# Temporal
TEMPORAL_PORT=9233
TEMPORAL_UI_PORT=9234

# LiteLLM
# Keep this on 4000 unless you also update the local service URLs that talk to LiteLLM.
LITELLM_PORT=4000
VERTEX_PROJECT=p-642-cilab-sandbox
VERTEX_LOCATION=us-central1
